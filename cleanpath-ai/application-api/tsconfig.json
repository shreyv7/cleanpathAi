{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "allowJs": false,
        "declaration": false,
        "declarationMap": false,
        "composite": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "types": [
            "node"
        ],
        "baseUrl": ".",
        "paths": {
            "@cleanpath/types": [
                "../shared/types/dist"
            ],
            "@cleanpath/logging": [
                "../shared/logging/dist"
            ],
            "@cleanpath/database": [
                "../shared/database/dist"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}